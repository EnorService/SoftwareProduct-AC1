# Configurações opcionais para sincronizar o board local com um GitHub Project v2.
# Copie este arquivo para .env e preencha os valores. O arquivo .env não deve ser
# enviado ao GitHub porque contém o token de acesso.

LANCHONETE_GITHUB_TOKEN=
LANCHONETE_GITHUB_OWNER=
LANCHONETE_GITHUB_OWNER_TYPE=user
LANCHONETE_GITHUB_PROJECT_NUMBER=

# Exemplos:
# LANCHONETE_GITHUB_OWNER=seu-usuario
# LANCHONETE_GITHUB_OWNER_TYPE=user
# LANCHONETE_GITHUB_PROJECT_NUMBER=1
#
# Para um projeto de organização, use:
# LANCHONETE_GITHUB_OWNER=nome-da-organizacao
# LANCHONETE_GITHUB_OWNER_TYPE=organization
